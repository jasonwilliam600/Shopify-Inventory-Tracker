!service_account.template.json

# Local database files and backups. Do not ignore all *.sql files:
# legitimate schema definitions and migrations must remain versioned.
/backups/
/database-backups/
/db-backups/
*.dump
*.pgdump
*.backup
*.sql.gz
*.sql.bz2
*.sql.xz
*.sql.zip
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
backup*.sql
*-backup*.sql
*_backup*.sql
dump*.sql
*-dump*.sql
*_dump*.sql
pg_dump*.sql
database.sql
!**/migrations/**/*.sql
!**/drizzle/**/*.sql

# Confidential source data and generated supplier/catalog reports.
# Keep the files locally; these are not required by the running application.
/attached_assets/products_export_*.zip
/attached_assets/image_*.png
/reports/

# Replit asset-library metadata and disposable generated output.
# Preserve .replit, artifact manifests, application assets, and project memory.
/.agents/agent_assets_metadata.toml
/generated-artifacts/
